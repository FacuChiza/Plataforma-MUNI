# ============================================================================
# PLANTILLA DE CONFIGURACIÓN - copiar como ".env" y completar
# ----------------------------------------------------------------------------
#   cp .env.example .env
# El archivo ".env" real NUNCA se commitea (está en .gitignore).
# ============================================================================

# --- Conexión a SQL Server --------------------------------------------------
# DB_SERVER acepta el nombre del equipo o la IP.
#
#   NTVMERLO      nombre del servidor en la red municipal (lo normal)
#   10.21.171.5   su IP, verificada el 02/09/2026
#
# Conviene dejar el NOMBRE y no la IP: si el servidor cambia de dirección por
# DHCP, el nombre sigue funcionando y la IP no. La IP queda anotada acá como
# respaldo, por si algún día el nombre no resuelve desde alguna máquina.
#
# Ojo: ambas direcciones solo son alcanzables DESDE LA RED MUNICIPAL. Desde
# afuera no hay ruta, y la salida correcta es una VPN. No pedir que se abra el
# puerto 1433 hacia internet.
DB_USER=usuario_sql
DB_PASSWORD=contraseña_sql
DB_SERVER=NTVMERLO
DB_DATABASE=PROGRAM

# Cifrado en tránsito. Hoy en false porque el SQL Server municipal todavía no
# expone TLS; pasar a true cuando lo soporte (ver TODO en server.js).
DB_ENCRYPT=false
DB_TRUST_CERT=true

# --- Servidor Express -------------------------------------------------------
PORT=8000

# --- Límite de filas por consulta de listado (anti-scraping del padrón) -----
MAX_ROWS=5000

# --- Rate limiting de /api/* ------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Datos de prueba (solo desarrollo) --------------------------------------
# Con MODO_DEMO=true, y SOLO cuando no hay conexion a la base municipal, la
# ficha de parcela responde con datos inventados en vez de dar error. Sirve
# para trabajar en el visor desde fuera de la red de la Municipalidad.
#
# Si hay conexion a SQL Server, esta variable se ignora por completo.
#
# Las fichas de prueba salen marcadas: cartel amarillo en pantalla y franja
# roja "DOCUMENTO SIN VALIDEZ" impresa en la plancheta.
#
# Dejar en false en el servidor.
MODO_DEMO=false
