# ============================================================================
#  CONFIGURACION DEL VISOR CATASTRAL - VILLA DE MERLO
# ============================================================================
#
#  COMPLETAR LAS CUATRO PRIMERAS LINEAS con los datos de conexion a la base
#  municipal, guardar (Ctrl+G) y cerrar.
#
#  Si no tenes esos datos, pediselos a quien administre el sistema de catastro.
#
#  Las lineas que empiezan con # son comentarios: no hace falta tocarlas.
#  Este archivo tiene la contrasena de la base: no compartirlo ni subirlo a
#  ningun lado.
#
# ============================================================================


# --- DATOS DE CONEXION (completar) ------------------------------------------

# Nombre del equipo donde esta la base, o su direccion IP.
# Conviene el nombre y no la IP: si el servidor cambia de direccion, el nombre
# sigue funcionando.
DB_SERVER=completar

# Nombre de la base de datos.
DB_DATABASE=completar

# Usuario y contrasena de la base.
DB_USER=completar
DB_PASSWORD=completar


# --- DE ACA PARA ABAJO NO HACE FALTA TOCAR NADA -----------------------------

# Cifrado de la conexion. En false porque el servidor municipal todavia no lo
# admite. Si algun dia lo habilitan, pasar a true.
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Puerto en el que queda escuchando este visor.
#
# 8001 A PROPOSITO, y no 8000: el visor anterior usa el 8000. Con puertos
# distintos los dos pueden estar abiertos al mismo tiempo sin pisarse. Si algo
# de este no funcionara, el anterior sigue disponible y en marcha, sin haber
# sido tocado.
#
#   http://localhost:8000   visor anterior
#   http://localhost:8001   este
PORT=8001

# Cantidad maxima de parcelas que devuelve una busqueda por filtros.
MAX_ROWS=5000

# Limite de consultas por minuto, para que nadie pueda descargar el padron
# entero de forma automatica.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ----------------------------------------------------------------------------
#  MODO DE PRUEBA
#
#  En false, que es como tiene que quedar en la Municipalidad: el visor muestra
#  los datos reales de la base, y si no puede conectarse lo dice claramente.
#
#  En true, cuando NO hay conexion, el visor inventa datos para poder probar la
#  pantalla. Sirve para desarrollar desde una computadora fuera de la red
#  municipal. Los datos inventados aparecen siempre marcados en pantalla y en
#  la plancheta, pero aun asi: no dejarlo en true en una computadora de trabajo.
# ----------------------------------------------------------------------------
MODO_DEMO=false
